# =============================================
# Enterprise Graph RAG - Environment Variables
# =============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ---- Google Gemini (Required) ----
# Get your free API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# ---- JWT Authentication (Required) ----
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_random_secret_key_minimum_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ---- Gemini Model Settings ----
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MAX_TOKENS=2048
GEMINI_TEMPERATURE=0.3

# ---- Embedding Model Settings ----
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ---- Storage Paths (auto-created if missing) ----
DATA_DIR=./data
UPLOADS_DIR=./data/uploads
QDRANT_PATH=./data/qdrant_storage
SQLITE_PATH=./data/enterprise_rag.db
GRAPH_PERSISTENCE_PATH=./data/knowledge_graph.json
KEYWORD_STORE_PATH=./data/keyword_store.pkl

# ---- App Settings ----
PROJECT_NAME=Enterprise Hybrid Graph-RAG System
VERSION=2.0.0
DEBUG=false
